--- !u!114 &8388656356953170333
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9142139106512379938}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 659e50802bb165e438ab85e57851f5ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AtlasAnatomico.OrganoController
  nombreOrgano: Pulmones
  kichwaOrgano: Surku
  prefijo: PUL_
  piezaReferencia: Diafragma
  piezaCentral: Bronquios
  piezaFrontal: Pulmon_Der_Lobulo_Med
  partes:
  - id: Traquea
    nombre: "Tr\xE1quea"
    kichwa: pendiente
    tunica: "V\xEDa a\xE9rea"
    descripcion: "Tubo que lleva el aire desde la laringe hasta los bronquios. Sus anillos de cart\xEDlago en forma de C la mantienen abierta."
    dato: "Mide ~11 cm y tiene entre 16 y 20 anillos. Por detr\xE1s es blanda, junto al es\xF3fago."
    paso: 0
    desglose: {x: -0, y: 0.089999996, z: -0}
    envoltura: 0
  - id: Bronquios
    nombre: Bronquios
    kichwa: pendiente
    tunica: "V\xEDa a\xE9rea"
    descripcion: "La tr\xE1quea se divide en dos bronquios principales, que se ramifican como un \xE1rbol cada vez m\xE1s fino hasta los alv\xE9olos."
    dato: "Unas 23 generaciones de ramas. El bronquio derecho es m\xE1s ancho y vertical."
    paso: 0
    desglose: {x: -0, y: 0, z: -0}
    envoltura: 0
  - id: Pulmon_Der_Lobulo_Sup
    nombre: "L\xF3bulo superior derecho"
    kichwa: pendiente
    tunica: "Pulm\xF3n derecho"
    descripcion: "Parte alta del pulm\xF3n derecho; su punta, el \xE1pice, sobresale por encima de la clav\xEDcula."
    dato: "La cisura horizontal lo separa del l\xF3bulo medio."
    paso: 0
    desglose: {x: 0.12, y: 0.08, z: -0}
    envoltura: 1
  - id: Pulmon_Der_Lobulo_Med
    nombre: "L\xF3bulo medio"
    kichwa: pendiente
    tunica: "Pulm\xF3n derecho"
    descripcion: "L\xF3bulo m\xE1s peque\xF1o, en forma de cu\xF1a, al frente del pulm\xF3n derecho."
    dato: "Solo existe en el derecho: 3 l\xF3bulos, frente a 2 del izquierdo."
    paso: 0
    desglose: {x: 0.17999999, y: -0.01, z: 0.03}
    envoltura: 1
  - id: Pulmon_Der_Lobulo_Inf
    nombre: "L\xF3bulo inferior derecho"
    kichwa: pendiente
    tunica: "Pulm\xF3n derecho"
    descripcion: "Ocupa la parte posterior y baja del pulm\xF3n derecho y se apoya sobre el diafragma."
    dato: "La cisura oblicua lo separa de los otros dos l\xF3bulos."
    paso: 0
    desglose: {x: 0.089999996, y: -0.13, z: -0.04}
    envoltura: 1
  - id: Pulmon_Izq_Lobulo_Sup
    nombre: "L\xF3bulo superior izquierdo"
    kichwa: pendiente
    tunica: "Pulm\xF3n izquierdo"
    descripcion: "Incluye el \xE1pice y la l\xEDngula. Su borde tiene un hueco para el coraz\xF3n: la incisura card\xEDaca."
    dato: "Por el coraz\xF3n, el pulm\xF3n izquierdo es algo m\xE1s peque\xF1o que el derecho."
    paso: 0
    desglose: {x: -0.13, y: 0.07, z: -0}
    envoltura: 1
  - id: Pulmon_Izq_Lobulo_Inf
    nombre: "L\xF3bulo inferior izquierdo"
    kichwa: pendiente
    tunica: "Pulm\xF3n izquierdo"
    descripcion: "Parte posterior y baja del pulm\xF3n izquierdo, sobre el diafragma."
    dato: "Entre los dos pulmones hay cientos de millones de alv\xE9olos: ~70 m\xB2 para intercambiar gases."
    paso: 0
    desglose: {x: -0.099999994, y: -0.13, z: -0.04}
    envoltura: 1
  - id: Diafragma
    nombre: Diafragma
    kichwa: pendiente
    tunica: "M\xFAsculo respiratorio"
    descripcion: "M\xFAsculo principal de la respiraci\xF3n. Al contraerse baja y se aplana: el t\xF3rax se agranda y entra el aire. Al relajarse sube y el aire sale."
    dato: "Baja ~1,5 cm en reposo y hasta 10 cm en una inspiraci\xF3n profunda."
    paso: 0
    desglose: {x: -0, y: -0.19, z: -0}
    envoltura: 0
  tituloPartes: Partes de los pulmones
  nombreGrupo: Grupo
  textoColorear: Colorear grupos
  desgloseRadial: 1
  frenteLocal: {x: 0, y: 0, z: 1}
  anguloCompleta: -18
  anguloDesglose: 0
  factorMenu: {x: 1.35, y: 2.1}
